use std/prelude;

use type;
use data_item;
global pub;

struct QbeData {
    string name,
    (QbeType, QbeDataItem)[] items,
}

fn QbeData::__fmt__(QbeData self, i32 nesting) {
    items := self.items
        .map(fn: "{} {}".format(it.x, it.y))
        .join(", ");

    return "export data ${} = {{ {} }".format(self.name, items);
}
