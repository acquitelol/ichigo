use ../../parser/lib/argument;

use block;
use type;
global pub;

struct QbeFunction {
    ObjectString name,
    Argument[] args,
    QbeType return_type,
    QbeBlock[] blocks,
}

fn QbeFunction::__fmt__(QbeFunction self, i32 nesting) {
    res := "";

    quote := self.name.original.iter().any(fn: it < 0) ? "\"" : "";
    res.extend("export function {} ${}{}{}({}) {{\n".format(
        self.return_type,
        quote,
        self.name.original,
        quote,
        self.args.map(fn: {
            ty := QbeType::from(it.type.original);
            name := x.name.encoded;

            return "{} %{}".format(ty, name);
        }).join(", ")
    ));

    for block in self.blocks {
        res.extend("{}\n".format(block));
    }

    res.push('}');
    return res;
}

fn QbeFunction::new(ObjectString name, Argument[] args, QbeType return_type) {
    return QbeFunction {
        name,
        args,
        return_type,
        blocks = [],
    };
}

fn QbeFunction::add_instruction(QbeFunction *self, QbeInstr instr) {
    self.blocks.last().unwrap().add_instruction(instr);
}

fn QbeFunction::jumps(QbeFunction *self) {
    return self.blocks.last().unwrap().jumps();
}
